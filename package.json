{
  "name": "politeia-web",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "brand",
    "packages/*",
    "apps/quorum",
    "services/quorum-api"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "blog-api:dev": "npm --prefix services/blog-api run dev",
    "blog-api:start": "npm --prefix services/blog-api start",
    "blog-api:test": "npm --prefix services/blog-api test",
    "blog-api:check": "npm --prefix services/blog-api run check",
    "blog-api:mail:check": "npm --prefix services/blog-api run mail:check",
    "blog-api:mail:test": "npm --prefix services/blog-api run mail:test",
    "blog-api:backfill:identity-keys": "npm --prefix services/blog-api run backfill:identity-keys --",
    "blog-api:cloud:build": "gcloud builds submit services/blog-api --tag us-central1-docker.pkg.dev/quick-function-500420-v6/politeia/blog-api:latest",
    "blog-api:cloud:deploy": "gcloud run deploy politeia-blog-api --image us-central1-docker.pkg.dev/quick-function-500420-v6/politeia/blog-api:latest --region us-central1 --allow-unauthenticated",
    "blog-api:cloud:build-deploy": "npm run blog-api:cloud:build && npm run blog-api:cloud:deploy",
    "blog-api:cloud:redeploy": "npm run blog-api:cloud:deploy",
    "blog-api:cloud:restart": "npm run blog-api:cloud:deploy",
    "blog-api:cloud:logs": "gcloud run services logs read politeia-blog-api --region us-central1 --limit=100",
    "blog-api:cloud:url": "gcloud run services describe politeia-blog-api --region us-central1 --format=\"value(status.url)\"",
    "blog-api:cloud:describe": "gcloud run services describe politeia-blog-api --region us-central1",
    "blog-api:cloud:env": "gcloud run services describe politeia-blog-api --region us-central1 --format=\"yaml(spec.template.spec.containers[0].env)\"",
    "blog-api:cloud:revisions": "gcloud run revisions list --service politeia-blog-api --region us-central1",
    "blog-api:cloud:auth": "gcloud auth application-default login",
    "blog-api:cloud:project": "gcloud config set project quick-function-500420-v6",
    "blog-api:cloud:quota-project": "gcloud auth application-default set-quota-project quick-function-500420-v6",
    "quorum:dev": "npm run dev --workspace @politeia/quorum-web",
    "quorum:api:dev": "npm run dev --workspace @politeia/quorum-api",
    "quorum:seed": "npm run seed --workspace @politeia/quorum-api",
    "quorum:verify:store": "npm run verify:store --workspace @politeia/quorum-api",
    "quorum:dev:persistent": "node scripts/run-quorum-dev.mjs",
    "quorum:migrate:glossary-inline": "npm run migrate:glossary-inline --workspace @politeia/quorum-api",
    "quorum:import:legislators": "npm run import:legislators --workspace @politeia/quorum-api",
    "quorum:test": "npm run test --workspace @politeia/quorum-contracts && npm run test --workspace @politeia/quorum-api && npm run test:unit --workspace @politeia/quorum-web",
    "quorum:check": "npm run check --workspace @politeia/quorum-contracts && npm run build --workspace @politeia/quorum-contracts && npm run check --workspace @politeia/quorum-api && npm run check --workspace @politeia/quorum-web",
    "quorum:build": "npm run build --workspace @politeia/quorum-contracts && npm run build --workspace @politeia/quorum-api && npm run build --workspace @politeia/quorum-web",
    "quorum:e2e": "node scripts/run-quorum-e2e.mjs",
    "quorum:secrets:check": "node scripts/check-quorum-secrets.mjs"
  },
  "dependencies": {
    "@tiptap/extension-bubble-menu": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "marked": "^18.0.5",
    "next": "^15.5.22",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.0",
    "@types/express": "4.17.25",
    "@types/express-serve-static-core": "4.19.9"
  }
}
