# Dependencies and generated output
node_modules/
**/node_modules/
.next/
**/.next/
**/.next-*/
out/
dist/
**/dist/
*.tsbuildinfo
**/*.tsbuildinfo
coverage/
test-results/
**/test-results/
playwright-report/
**/playwright-report/

# Local environment files. Keep documented templates versioned.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Logs and local tooling
*.log
.next-dev*.log
.DS_Store
.vercel/

# Credentials and private configuration
.secrets/
**/.secrets/
*.service-account.json
*service-account*.json
application_default_credentials.json
credentials*.json
*.pem
*.key
*.p12
*.pfx
*.secret.yaml
*.secret.yml
cloudrun-env.local.yaml
cloudrun-env.local.yml
cloudrun-env.yaml

# Terraform state and private values never belong in Git.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfplan
crash.log
!*.tfvars.example

