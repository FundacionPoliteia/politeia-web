{
  "framework": "nextjs",
  "buildCommand": "cd ../.. && npm run build --workspace @politeia/quorum-web",
  "installCommand": "cd ../.. && npm ci",
  "regions": ["gru1"],
  "headers": [
    { "source": "/gestion/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }, { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }] },
    { "source": "/acceso", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }, { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }] }
  ]
}
